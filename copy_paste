# ══════════════════════════════════════════════════════════════════════════
#  BALANCE ORGANIQUE UPGRADE ↔ DOWNGRADE — clients EXISTANTS uniquement
#
#  On ne garde que les transitions retail ↔ retail d'un client present DEUX
#  mois consecutifs :
#     • upgrade   = Mass retail / MR a potentiel  ->  Mass Affluent
#     • downgrade = Mass Affluent  ->  Mass retail / MR a potentiel
#  Cela EXCLUT de fait les acquisitions (statut d'origine = NaN) et le
#  downstream banque privee (statut d'origine hors retail). Resultat : le NET
#  DELTA organique upgrade - downgrade, celui qui nous interesse.
#
#  A coller dans une cellule APRES la construction de seg_wide.
#  Prerequis dans le kernel : seg_wide, periods, ANALYSIS_START, MA_LABEL,
#  idx_to_ym, COL, FIG_DIR.
# ══════════════════════════════════════════════════════════════════════════
import numpy as np, pandas as pd, matplotlib.pyplot as plt

MA           = MA_LABEL
RETAIL_LOWER = {"Mass retail", "Mass retail à potentiel"}   # retail sous le MA

rows = []
for p in periods:
    if p + 1 not in seg_wide.columns:
        continue
    a, b = seg_wide[p], seg_wide[p + 1]                     # statut a p (origine) et p+1
    up   = a.isin(RETAIL_LOWER) & (b == MA)                 # upgrade   retail -> MA
    down = (a == MA) & b.isin(RETAIL_LOWER)                 # downgrade MA -> retail
    rows.append({"periode": p, "upgrade": int(up.sum()), "downgrade": int(down.sum())})

bal = pd.DataFrame(rows)
bal = bal[bal["periode"] >= ANALYSIS_START].copy()          # fenetre analysee
bal["net"]     = bal["upgrade"] - bal["downgrade"]          # ★ net delta organique
bal["net_cum"] = bal["net"].cumsum()                        # deficit cumule
bal["mois"]    = bal["periode"].map(idx_to_ym)

U, D = int(bal["upgrade"].sum()), int(bal["downgrade"].sum())
print("Balance organique upgrade <-> downgrade (clients existants) :")
print(bal[["mois", "upgrade", "downgrade", "net", "net_cum"]].to_string(index=False))
print(f"\nTotal upgrades      : {U:,}")
print(f"Total downgrades    : {D:,}   (a rapprocher des 14 248 declassements de la §3)")
print(f"NET DELTA organique : {U - D:+,}   | ratio upgrade/downgrade = {U / max(D, 1):.2f}")
print(f"Mois a solde negatif : {(bal['net'] < 0).sum()} / {len(bal)}")

# ── Graphe : upgrade (haut) vs downgrade (bas) + net ; deficit cumule dessous ──
fig, ax = plt.subplots(2, 1, figsize=(13, 8), sharex=True,
                       gridspec_kw={"height_ratios": [2, 1]})
x = np.arange(len(bal))
ax[0].bar(x,  bal["upgrade"],   color=COL["active"], label="Upgrade (retail -> MA)")
ax[0].bar(x, -bal["downgrade"], color=COL["mix"],    label="Downgrade (MA -> retail)")
ax[0].plot(x, bal["net"], color=COL["dark"], marker="o", lw=2, label="Net mensuel (upgrade - downgrade)")
ax[0].axhline(0, color="#94A3B8", lw=1)
ax[0].set_ylabel("Nb de clients / mois")
ax[0].set_title(f"Balance organique upgrade <-> downgrade — net {U - D:+,} sur la periode "
                f"(clients existants, hors acquisition & banque privee)")
ax[0].legend(fontsize=9, loc="upper left")

ax[1].fill_between(x, bal["net_cum"], 0, color=COL["accent"], alpha=0.25)
ax[1].plot(x, bal["net_cum"], color=COL["accent"], lw=2, marker="s", ms=4)
ax[1].axhline(0, color="#94A3B8", lw=1)
ax[1].set_ylabel("Net cumule")
ax[1].set_title("Deficit organique cumule sur la fenetre")
ax[1].set_xticks(x); ax[1].set_xticklabels(bal["mois"], rotation=45, ha="right")

plt.tight_layout()
plt.savefig(FIG_DIR / "11_balance_upgrade_downgrade.png", bbox_inches="tight", facecolor="white")
plt.show()
