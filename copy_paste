# ══════════════════════════════════════════════════════════════════════════
#  CENTRES CRÉDIT IMMO — CAPACITÉ D'APPEL vs STOCK CLIENTS
#  1 ligne = 1 client rattaché à un centre (CCI).
#  Objectif :
#    (1) distribution du nb de clients par centre
#    (2) simulation : à 2, 3, 4, 5 appels/jour, en combien de jours (ouvrés)
#        chaque centre a-t-il appelé TOUT son stock ?
#  Mécanique : chaque centre traite son stock en parallèle →
#    jours d'un centre = ceil(nb_clients / appels_par_jour)
#    jours pour vider TOUTE la liste = max des centres (le plus gros contraint).
#  → Adapte le bloc CONFIG puis exécute les cellules dans l'ordre.
# ══════════════════════════════════════════════════════════════════════════

# ─────────────────────────── CELLULE 0 · CONFIG + CHARGEMENT ────────────────
import pandas as pd, numpy as np, matplotlib.pyplot as plt

FILE               = "clients_centres.xlsx"   # .xlsx / .csv / .parquet
COL_ID             = "Identifiant Tiers"
COL_CCI            = "CCI"
CALLS              = [2, 3, 4, 5]             # rythmes d'appels/jour à tester
WORKING_DAYS_MONTH = 21                       # jours ouvrés / mois (réf. renouvellement du stock)

if   FILE.endswith(".xlsx"):    df = pd.read_excel(FILE)
elif FILE.endswith(".parquet"): df = pd.read_parquet(FILE)
else:                           df = pd.read_csv(FILE)

print("Lignes brutes :", len(df), "| doublons ID :", int(df[COL_ID].duplicated().sum()))
df = df.dropna(subset=[COL_ID, COL_CCI]).drop_duplicates([COL_ID])   # 1 client compté une fois
print("Clients uniques :", df[COL_ID].nunique(), "| Centres :", df[COL_CCI].nunique())


# ──────────────── CELLULE 1 · DISTRIBUTION DU STOCK PAR CENTRE ──────────────
stock = (df.groupby(COL_CCI)[COL_ID].nunique()
           .sort_values(ascending=False).rename("nb_clients"))
print("Stock par centre — statistiques :")
print(stock.describe().round(1))
print(f"\nStock total : {stock.sum():,} clients réparties sur {len(stock)} centres")
print("\nTop 10 centres (plus gros stock) :"); print(stock.head(10))
print("\nBottom 10 centres :");                print(stock.tail(10))

fig, ax = plt.subplots(1, 2, figsize=(13, 4.6))
ax[0].hist(stock.values, bins=30, color="#1E6FA8", edgecolor="white")
ax[0].set_title("Distribution du nb de clients par centre")
ax[0].set_xlabel("clients par centre"); ax[0].set_ylabel("nb de centres")
stock.head(15).iloc[::-1].plot.barh(ax=ax[1], color="#0F8A5F")
ax[1].set_title("Top 15 centres par stock"); ax[1].set_xlabel("clients")
plt.tight_layout(); plt.show()


# ──────────── CELLULE 2 · SIMULATION — JOURS POUR VIDER LE STOCK ────────────
sim = pd.DataFrame({"nb_clients": stock})
for r in CALLS:
    sim[f"jours_{r}_par_jour"] = np.ceil(sim["nb_clients"] / r).astype(int)
print("Jours ouvrés pour appeler tout le stock, par centre (extrait) :")
print(sim.head(10))

# Résumé par rythme
rows = {}
for r in CALLS:
    d = np.ceil(stock / r)
    rows[f"{r} appels/j"] = {
        "médiane jours":                 float(d.median()),
        "moyenne jours":                 round(float(d.mean()), 1),
        "MAX jours (= vider la liste)":  int(d.max()),
        f"% centres > {WORKING_DAYS_MONTH}j ouvrés": round(float((d > WORKING_DAYS_MONTH).mean() * 100), 1),
        f"nb centres > {WORKING_DAYS_MONTH}j":       int((d > WORKING_DAYS_MONTH).sum()),
    }
summary = pd.DataFrame(rows).T
print("\nRésumé par rythme d'appel :")
print(summary)
print(f"\nLecture : à 5 appels/j, il faut {int(np.ceil(stock/5).max())} jours ouvrés pour que "
      f"MÊME le plus gros centre ait tout appelé (les centres travaillent en parallèle).")

# Courbe de capacité : % de centres ayant vidé leur stock au jour d, par rythme
fig, ax = plt.subplots(figsize=(11, 5))
maxd   = int(np.ceil(stock / min(CALLS)).max())
days   = np.arange(1, maxd + 1)
colors = ["#1E6FA8", "#0F8A5F", "#E0912A", "#C13E70", "#7A5AA6"]
for r, c in zip(CALLS, colors):
    dneed = np.ceil(stock / r)
    pct   = [(dneed <= d).mean() * 100 for d in days]
    ax.plot(days, pct, lw=2, color=c, label=f"{r} appels/j")
ax.axvline(WORKING_DAYS_MONTH, color="#94A3B8", ls="--", lw=1.5,
           label=f"{WORKING_DAYS_MONTH} j ouvrés (~1 mois)")
ax.set_xlabel("jours ouvrés"); ax.set_ylabel("% de centres ayant vidé leur stock")
ax.set_title("Capacité d'appel : % de centres ayant appelé tous leurs clients, selon le rythme")
ax.set_ylim(0, 101); ax.legend(); ax.grid(alpha=.3)
plt.tight_layout(); plt.show()

