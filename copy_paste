windows = [2, 3, 4, 5, 6, 12, 24]  # months

def products_in_window(months):
    threshold_days = months * 30.44
    # Clients observable for this window
    eligible = client_meta[client_meta["tenure_days"] >= threshold_days].index
    
    subs = df_unique[
        (df_unique["Identifiant Tiers"].isin(eligible)) &
        (df_unique["days_to_sub"] <= threshold_days)
    ]
    
    product_counts = (
        subs.groupby("Produits")
            .size()
            .rename("n_subscriptions")
            .to_frame()
    )
    product_counts["n_clients_eligible"] = len(eligible)
    product_counts["penetration_pct"] = (
        product_counts["n_subscriptions"] / len(eligible) * 100
    ).round(1)
    product_counts["share_of_window_pct"] = (
        product_counts["n_subscriptions"] / product_counts["n_subscriptions"].sum() * 100
    ).round(1)
    product_counts["window_months"] = months
    
    return product_counts.reset_index()

window_mix = pd.concat([products_in_window(m) for m in windows], ignore_index=True)




