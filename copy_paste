# ══════════════════════════════════════════════════════════════════════════
#  BALANCE ORGANIQUE UPGRADE ↔ DOWNGRADE — clients EXISTANTS uniquement
#
#  On ne garde que les transitions retail ↔ retail d'un client present DEUX
#  mois consecutifs :
#     • upgrade   = Mass retail / MR a potentiel  ->  Mass Affluent
#     • downgrade = Mass Affluent  ->  Mass retail / MR a potentiel
#  Cela EXCLUT de fait les acquisitions (statut d'origine = NaN) et le
#  downstream banque privee (statut d'origine hors retail).
#
#  A coller dans une cellule APRES la construction de seg_wide.
#  Prerequis : seg_wide, periods, ANALYSIS_START, MA_LABEL, idx_to_ym, COL, FIG_DIR.
# ══════════════════════════════════════════════════════════════════════════
import numpy as np, pandas as pd, matplotlib.pyplot as plt

MA           = MA_LABEL
RETAIL_LOWER = {"Mass retail", "Mass retail à potentiel"}   # retail sous le MA

rows = []
for p in periods:
    if p + 1 not in seg_wide.columns:
        continue
    a, b = seg_wide[p], seg_wide[p + 1]                     # statut a p (origine) et p+1
    up   = a.isin(RETAIL_LOWER) & (b == MA)                 # upgrade   retail -> MA
    down = (a == MA) & b.isin(RETAIL_LOWER)                 # downgrade MA -> retail
    rows.append({"periode": p, "upgrade": int(up.sum()), "downgrade": int(down.sum())})

bal = pd.DataFrame(rows)
bal = bal[bal["periode"] >= ANALYSIS_START].copy()
bal["net"]     = bal["upgrade"] - bal["downgrade"]
bal["net_cum"] = bal["net"].cumsum()
bal["mois"]    = bal["periode"].map(idx_to_ym)

U, D = int(bal["upgrade"].sum()), int(bal["downgrade"].sum())
print("Balance organique upgrade <-> downgrade (clients existants) :")
print(bal[["mois", "upgrade", "downgrade", "net", "net_cum"]].to_string(index=False))
print(f"\nTotal upgrades      : {U:,}")
print(f"Total downgrades    : {D:,}   (a rapprocher des 14 248 declassements de la §3)")
print(f"NET DELTA organique : {U - D:+,}   | ratio upgrade/downgrade = {U / max(D, 1):.2f}")
print(f"Mois a solde negatif : {(bal['net'] < 0).sum()} / {len(bal)}")


# ══════════════════════════════════════════════════════════════════════════
#  ★ CHECK DECISIF — UPGRADE : NOUVELLE PROMOTION vs RETOUR (revolving door)
#
#  Le net brut est gonfle par les RETOURS : ~31% des declasses reviennent MA
#  (§9) et sont recomptes en "upgrade". On isole les VRAIES nouvelles promotions
#  (client JAMAIS MA auparavant) pour obtenir le net organique reel.
#     net_first = nouvelles promotions - downgrades   <-- l'indicateur qui compte
# ══════════════════════════════════════════════════════════════════════════
ma_bool  = (seg_wide == MA)
first_ma = pd.Series(np.nan, index=seg_wide.index)          # 1re periode MA observee / client
for p in seg_wide.columns:
    m = ma_bool[p] & first_ma.isna()
    first_ma[m] = p

rows = []
for p in periods:
    if p + 1 not in seg_wide.columns:
        continue
    a, b = seg_wide[p], seg_wide[p + 1]
    up   = a.isin(RETAIL_LOWER) & (b == MA)
    down = (a == MA) & b.isin(RETAIL_LOWER)
    rows.append({
        "periode":   p,
        "up_first":  int((up & (first_ma == p + 1)).sum()),  # jamais MA avant = vraie promotion
        "up_return": int((up & (first_ma <  p + 1)).sum()),  # deja MA avant  = revolving door
        "downgrade": int(down.sum()),
    })
d2 = pd.DataFrame(rows)
d2 = d2[d2["periode"] >= ANALYSIS_START].copy()
d2["net_first"] = d2["up_first"] - d2["downgrade"]           # ★ net des NOUVELLES promotions
d2["net_brut"]  = d2["up_first"] + d2["up_return"] - d2["downgrade"]
d2["mois"]      = d2["periode"].map(idx_to_ym)

F, R, Dd = int(d2["up_first"].sum()), int(d2["up_return"].sum()), int(d2["downgrade"].sum())
print("\nUpgrade decompose : nouvelle promotion vs retour")
print(d2[["mois", "up_first", "up_return", "downgrade", "net_first", "net_brut"]].to_string(index=False))
print(f"\nNouvelles promotions (jamais MA avant) : {F:,}")
print(f"Retours (revolving door)               : {R:,}")
print(f"Downgrades                             : {Dd:,}")
print(f"NET nouvelles promotions : {F - Dd:+,}   <-- indicateur organique REEL")
print(f"NET brut (avec retours)  : {F + R - Dd:+,}")

# ── Graphes ────────────────────────────────────────────────────────────────
fig, ax = plt.subplots(2, 1, figsize=(13, 9), sharex=True,
                       gridspec_kw={"height_ratios": [1, 1]})
x = np.arange(len(bal))
ax[0].bar(x,  bal["upgrade"],   color=COL["active"], label="Upgrade brut (retail -> MA)")
ax[0].bar(x, -bal["downgrade"], color=COL["mix"],    label="Downgrade (MA -> retail)")
ax[0].plot(x, bal["net"], color=COL["dark"], marker="o", lw=2, label="Net brut")
ax[0].axhline(0, color="#94A3B8", lw=1)
ax[0].set_ylabel("Nb clients / mois"); ax[0].legend(fontsize=8, loc="upper left")
ax[0].set_title(f"Brut : net {U - D:+,} (gonfle par les retours)")

xf = np.arange(len(d2))
ax[1].bar(xf, d2["up_first"],  color=COL["active"], label="Nouvelle promotion (jamais MA)")
ax[1].bar(xf, d2["up_return"], bottom=d2["up_first"], color=COL["avoirs"], label="Retour (revolving door)")
ax[1].bar(xf, -d2["downgrade"], color=COL["mix"], label="Downgrade")
ax[1].plot(xf, d2["net_first"], color=COL["dark"], marker="o", lw=2, label="Net NOUVELLES promotions")
ax[1].axhline(0, color="#94A3B8", lw=1)
ax[1].set_ylabel("Nb clients / mois"); ax[1].legend(fontsize=8, loc="upper left", ncol=2)
ax[1].set_title(f"Net reel des nouvelles promotions : {F - Dd:+,}")
ax[1].set_xticks(xf); ax[1].set_xticklabels(d2["mois"], rotation=45, ha="right")

plt.tight_layout()
plt.savefig(FIG_DIR / "11_balance_upgrade_downgrade.png", bbox_inches="tight", facecolor="white")
plt.show()
