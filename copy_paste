windows = [2, 3, 4, 5, 6, 12, 24]

# Per-client total products at snapshot (the denominator)
client_totals = (
    df_unique.groupby("Identifiant Tiers")
    .agg(total_products=("Produits", "size"),
         join_date=("Date Création", "first"))
)
client_totals["tenure_days"] = (snapshot_date - client_totals["join_date"]).dt.days
client_totals["join_year"] = client_totals["join_date"].dt.year

# Per-client products by family (for the family-level breakdown)
family_totals = (
    df_unique.groupby(["Identifiant Tiers", "Famille Produit"])
    .size()
    .rename("family_total")
    .reset_index()
)

def pct_at_month(months):
    threshold = months * 30.44
    eligible = client_totals[client_totals["tenure_days"] >= threshold].index
    
    # Count each client's acquisitions within the window
    acquired = (
        df_unique[
            (df_unique["Identifiant Tiers"].isin(eligible)) &
            (df_unique["days_to_sub"] <= threshold)
        ]
        .groupby("Identifiant Tiers").size()
        .reindex(eligible, fill_value=0)
    )
    
    # Per-client ratio: acquired so far / final total
    ratio = (acquired / client_totals.loc[eligible, "total_products"] * 100)
    
    return pd.DataFrame({
        "window_months": months,
        "client_id": ratio.index,
        "pct_of_final": ratio.values,
        "join_year": client_totals.loc[eligible, "join_year"].values,
    })

per_client = pd.concat([pct_at_month(m) for m in windows], ignore_index=True)





