def pct_at_month_by_family(months):
    threshold = months * 30.44
    eligible = client_totals[client_totals["tenure_days"] >= threshold].index
    
    acquired_by_fam = (
        df_unique[
            (df_unique["Identifiant Tiers"].isin(eligible)) &
            (df_unique["days_to_sub"] <= threshold)
        ]
        .groupby(["Identifiant Tiers", "Famille Produit"]).size()
        .rename("acquired").reset_index()
    )
    
    merged = family_totals[family_totals["Identifiant Tiers"].isin(eligible)].merge(
        acquired_by_fam, on=["Identifiant Tiers", "Famille Produit"], how="left"
    )
    merged["acquired"] = merged["acquired"].fillna(0)
    merged["pct_of_final"] = merged["acquired"] / merged["family_total"] * 100
    merged["window_months"] = months
    return merged

per_client_family = pd.concat([pct_at_month_by_family(m) for m in windows],
                               ignore_index=True)

by_family = (
    per_client_family.groupby(["Famille Produit", "window_months"])["pct_of_final"]
    .mean().round(1).unstack("window_months")
)
print(by_family)


