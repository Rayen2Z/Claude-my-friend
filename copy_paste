def products_in_window(months, group_col="Produits"):
    threshold_days = months * 30.44
    eligible = client_meta[client_meta["tenure_days"] >= threshold_days].index
    
    subs = df_unique[
        (df_unique["Identifiant Tiers"].isin(eligible)) &
        (df_unique["days_to_sub"] <= threshold_days)
    ]
    
    grouped = subs.groupby(group_col).agg(
        n_subscriptions=("Identifiant Tiers", "size"),
        n_clients=("Identifiant Tiers", "nunique"),
    )
    grouped["n_clients_eligible"] = len(eligible)
    grouped["penetration_pct"] = (grouped["n_clients"] / len(eligible) * 100).round(1)
    grouped["share_of_window_pct"] = (
        grouped["n_subscriptions"] / grouped["n_subscriptions"].sum() * 100
    ).round(1)
    grouped["window_months"] = months
    
    return grouped.reset_index()

