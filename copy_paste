plt.figure(figsize=(11, 5))

plt.hist(avoirs, bins=40, edgecolor="black", alpha=0.75)

plt.axvline(avoirs.median(), color="green",
            linestyle="--", label=f"Médiane : {avoirs.median():,.0f} €")

plt.axvline(48917, color="orange",
            linestyle="--", label="Moyenne non intéressés : 48 917 €")

plt.axvline(62000, color="red",
            linestyle="--", label="Seuil Mass Affluent : 62 000 €")

plt.xlabel("Avoirs (€)")
plt.ylabel("Nombre de clients")
plt.title("Distribution des avoirs – Clients non-Mass Affluent")
plt.legend()
plt.tight_layout()
plt.show()



