import pandas as pd

horizons = [12, 24, 36, 48]

# Remove accidental duplicate client-period rows
df = (
    test[
        ["identifiant_tiers", "periode", "acq_period", "annee_acquisition"]
    ]
    .drop_duplicates(["identifiant_tiers", "periode"])
    .copy()
)

# Last available period in the full dataset
data_max_period = df["periode"].max()

# One row per client
clients = (
    df.groupby("identifiant_tiers", as_index=False)
      .agg(
          annee_acquisition=("annee_acquisition", "first"),
          acq_period=("acq_period", "first"),
          last_period=("periode", "max")
      )
)

results = []

for h in horizons:
    evaluation_period = clients["acq_period"] + h

    # Only include clients for whom the dataset reaches this horizon
    observable = evaluation_period <= data_max_period

    temp = clients.loc[observable].copy()

    # Cumulative churn:
    # client is absent before reaching acquisition period + h
    temp["churned"] = temp["last_period"] < (
        temp["acq_period"] + h
    )

    cohort_result = (
        temp.groupby("annee_acquisition")
            .agg(
                observable_clients=("identifiant_tiers", "nunique"),
                churned_clients=("churned", "sum")
            )
            .reset_index()
    )

    cohort_result["horizon_months"] = h
    cohort_result["churn_rate"] = (
        cohort_result["churned_clients"]
        / cohort_result["observable_clients"]
    )

    results.append(cohort_result)

churn_by_cohort = pd.concat(results, ignore_index=True)




