
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Charger le fichier
df = pd.read_excel("stock_clients.xlsx")

# Adapter les noms de colonnes et la valeur du segment
non_ma = df[df["segment"] == "NON_MA"].copy()

avoirs = pd.to_numeric(non_ma["avoirs"], errors="coerce").dropna()

# Statistiques générales
print(f"Nombre de clients : {len(avoirs):,}")
print(f"Avoirs moyens : {avoirs.mean():,.0f} €")
print(f"Médiane : {avoirs.median():,.0f} €")
print(f"Écart-type : {avoirs.std():,.0f} €")
print(f"Minimum : {avoirs.min():,.0f} €")
print(f"Maximum : {avoirs.max():,.0f} €")

# Distribution par quantiles
print("\nQuantiles :")
print(avoirs.quantile([0.10, 0.25, 0.50, 0.75, 0.90, 0.95]))

# Proportions au-dessus des seuils
print("\nProportion de clients par seuil :")
for seuil in [20000, 30000, 40000, 45000, 50000, 55000, 60000]:
    pct = (avoirs >= seuil).mean() * 100
    print(f">= {seuil:,} € : {pct:.2f} %")



