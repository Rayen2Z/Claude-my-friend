flux_prev_avg   = df[[f"Flux {m}"   for m in range(380, 385)]].fillna(0).mean(axis=1)
avoirs_prev_avg = df[[f"Avoirs {m}" for m in range(380, 385)]].fillna(0).mean(axis=1)

