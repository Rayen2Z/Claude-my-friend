2. Marginal acquisitions between windows — this is the better view for "which products need more time":
pivot = window_mix.pivot_table(
    index="Produits", columns="window_months",
    values="penetration_pct", fill_value=0
)
# Marginal penetration gained in each interval
pivot_marginal = pivot.diff(axis=1).fillna(pivot.iloc[:, [0]])
print(pivot_marginal.round(1))



fast = pivot_marginal.loc[pivot_marginal[2] / pivot_marginal.sum(axis=1) > 0.5]
slow = pivot_marginal.loc[pivot_marginal[24] / pivot_marginal.sum(axis=1) > 0.3]

print(f"Fast products (>50% acquired in first 2 months): {fast.index.tolist()}")
print(f"Slow products (>30% acquired after month 12):   {slow.index.tolist()}")
