drops = pd.DataFrame({
    "flux_385":          flux_385,
    "flux_384":          flux_384,
    "flux_prev_5m_avg":  flux_prev_avg,
    "flux_drop_vs_384":  flux_384 - flux_385,
    "flux_drop_vs_avg":  flux_prev_avg - flux_385,
    "avoirs_385":            avoirs_385,
    "avoirs_384":            avoirs_384,
    "avoirs_prev_5m_avg":    avoirs_prev_avg,
    "avoirs_drop_vs_384":    avoirs_384 - avoirs_385,
    "avoirs_drop_vs_avg":    avoirs_prev_avg - avoirs_385,
})

# Aggregate summary
summary = drops[[
    "flux_drop_vs_384", "flux_drop_vs_avg",
    "avoirs_drop_vs_384", "avoirs_drop_vs_avg",
]].agg(["mean", "median", "sum"]).round(1)
print(summary)

# Percentage drops (median is safer than mean here — outliers and divide-by-zero distort the mean)
pct = pd.DataFrame({
    "flux_pct_drop_vs_384":   (1 - flux_385   / flux_384.replace(0, pd.NA))   * 100,
    "flux_pct_drop_vs_avg":   (1 - flux_385   / flux_prev_avg.replace(0, pd.NA))   * 100,
    "avoirs_pct_drop_vs_384": (1 - avoirs_385 / avoirs_384.replace(0, pd.NA)) * 100,
