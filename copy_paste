#  JEUNES < 25 ANS — ACQUISITIONS & NBI  (analyse simple, faveur collègue)
#  1 ligne = 1 client × 1 période.  Colonnes attendues : id, période,
#  NBI mensuel, année d'acquisition, âge.
#  Objectif :
#    (1) évolution du nb d'acquisitions + projection reste 2026 & 2027
#    (2) NBI moyen par jeune client par an + son évolution
#  → Adapte le bloc CONFIG, puis exécute les cellules dans l'ordre.
# ══════════════════════════════════════════════════════════════════════════

# ─────────────────────────── CELLULE 0 · CONFIG + CHARGEMENT ────────────────
import pandas as pd, numpy as np, matplotlib.pyplot as plt

FILE        = "jeunes_moins25.parquet"    # .parquet ou .csv
COL_ID      = "identifiant_tiers"         # id client
COL_PERIOD  = "période"                   # 1 valeur par mois
COL_NBI     = "nbi"                        # NBI du mois
COL_ACQYR   = "annee_acquisition"         # année d'acquisition (entier, ex. 2023)
COL_AGE     = "age"                        # âge
MONTHS_2026 = 7                            # mois de 2026 présents (jan→juil = 7)

df = pd.read_parquet(FILE) if FILE.endswith(".parquet") else pd.read_csv(FILE)
print("Lignes :", len(df), "| Clients :", df[COL_ID].nunique())
print("Colonnes :", list(df.columns))
print(df.dtypes)
df.head()


# ─────────────────── CELLULE 1 · ANNÉE CALENDAIRE DE CHAQUE LIGNE ───────────
#  Nécessaire pour le NBI par an (année du mois, pas année d'acquisition).
#  Gère : date, 'AAAA-MM', 'AAAAMM', ou index entier façon CLV (avec ancrage).
per = df[COL_PERIOD]
s   = per.astype(str)
if np.issubdtype(per.dtype, np.datetime64) or s.str.match(r"\d{4}-\d{2}").all():
    df["cal_year"] = pd.to_datetime(per, errors="coerce").dt.year
elif s.str.fullmatch(r"\d{6}").all():                       # AAAAMM
    df["cal_year"] = s.str[:4].astype(int)
else:
    # période = index entier (façon fichiers stock CLV) : ancre un point connu.
    ANCHOR_PERIOD, ANCHOR_YEAR, ANCHOR_MONTH = 371, 2024, 11   # ← À AJUSTER si besoin
    m = per.astype(int) - ANCHOR_PERIOD
    df["cal_year"] = ANCHOR_YEAR + ((ANCHOR_MONTH - 1 + m) // 12)
print(df["cal_year"].value_counts().sort_index())


# ──────────────── CELLULE 2 · ACQUISITIONS PAR AN + PROJECTION ──────────────
acq = (df.drop_duplicates(COL_ID)              # 1 client compté une fois
         .groupby(COL_ACQYR)[COL_ID].count()
         .rename("acquisitions").sort_index())
print("Acquisitions par année d'acquisition :"); print(acq, "\n")

full   = acq[acq.index <= 2025]                 # années complètes 2021→2025
ytd26  = int(acq.get(2026, 0))
proj26 = round(ytd26 * 12 / MONTHS_2026)        # annualisation simple du réalisé 2026

# 2027 : tendance linéaire sur les années pleines + variante CAGR
yrs, vals = full.index.values.astype(float), full.values.astype(float)
a, b = np.polyfit(yrs, vals, 1)
proj27_lin  = round(a * 2027 + b)
cagr        = (full.iloc[-1] / full.iloc[0]) ** (1 / (len(full) - 1)) - 1
proj27_cagr = round(proj26 * (1 + cagr))

print(f"2026 : {ytd26} acquis. sur {MONTHS_2026} mois  →  projeté année pleine ≈ {proj26}")
print(f"2027 (tendance linéaire) ≈ {proj27_lin}")
print(f"2027 (CAGR {cagr:+.1%}, base 2026 projeté) ≈ {proj27_cagr}")

fig, ax = plt.subplots(figsize=(10, 5))
ax.bar(full.index.astype(str), full.values, color="#1E6FA8", label="Réalisé (année pleine)")
ax.bar("2026", ytd26, color="#9DC3E0", label=f"2026 réalisé ({MONTHS_2026} mois)")
ax.bar("2026", proj26 - ytd26, bottom=ytd26, color="#E0912A", label="2026 projeté (reste)")
ax.bar("2027", proj27_lin, color="#C13E70", label="2027 projeté (tendance)")
ax.set_ylabel("Nb d'acquisitions < 25 ans")
ax.set_title("Acquisitions jeunes par an + projection 2026 / 2027")
ax.legend(fontsize=8); plt.tight_layout(); plt.show()


# ──────────────── CELLULE 3 · NBI MOYEN PAR JEUNE CLIENT PAR AN ─────────────
g = df.groupby("cal_year").agg(nbi_total=(COL_NBI, "sum"),
                               n_clients=(COL_ID, "nunique"),
                               nbi_moy_mensuel=(COL_NBI, "mean"))       # par client-mois (comparable)
g["nbi_moy_annuel_par_client"] = g["nbi_total"] / g["n_clients"]        # /!\ 2026 partiel (7 mois)
print(g.round(1))

fig, ax = plt.subplots(1, 2, figsize=(13, 5))
x = g.index.astype(str)
ax[0].plot(x, g["nbi_moy_mensuel"], marker="o", lw=2, color="#0F8A5F")
ax[0].set_title("NBI moyen mensuel par client\n(comparable entre années)")
ax[0].set_ylabel("€ / client-mois")
ax[1].plot(x, g["nbi_moy_annuel_par_client"], marker="s", lw=2, color="#1E6FA8")
ax[1].set_title("NBI moyen annuel par client\n(2026 = 7 mois → partiel)")
ax[1].set_ylabel("€ / client / an")
for a_ in ax:
    for xi, yi in zip(x, a_.lines[0].get_ydata()):
        a_.annotate(f"{yi:,.0f}", (xi, yi), textcoords="offset points", xytext=(0, 8), ha="center", fontsize=8)
    a_.tick_params(axis="x", rotation=45)
plt.tight_layout(); plt.show()

