# Option B: keep full population but report it explicitly with a tenure breakdown,
# so readers can see how the curve shifts by maturity
per_client = per_client.merge(
    client_totals["tenure_days"].rename("tenure"), 
    left_on="client_id", right_index=True
)
per_client["tenure_bucket"] = pd.cut(
    per_client["tenure"] / 365,
    bins=[0, 1, 2, 3, 5, 100],
    labels=["<1yr", "1-2yr", "2-3yr", "3-5yr", "5yr+"]
)
by_tenure = (
    per_client.groupby(["tenure_bucket", "window_months"], observed=True)["pct_of_final"]
    .mean().round(1).unstack("window_months")
)
print(by_tenure)

