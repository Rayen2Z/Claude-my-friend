# ══════════════════════════════════════════════════════════════════════════
#  TABLE CHURN CUMULE par cohorte (Y+1 -> Y+5) — AUTONOME
#
#  Recompute TOUS les objets de churn depuis flux / stock / upstream / cli / acq,
#  a l'interieur de la fonction. Aucune variable globale stale ne peut fausser le
#  resultat : c'est exactement la methode du diagnostic (2018 Y+4 -> ~24.6 %),
#  generalisee a toutes les cohortes et tous les horizons.
#
#  NB : le bord de donnees est PAR COHORTE (obs_end), pas global. Un bord global
#  (max periode = 384) declarerait tous les 2018 encore actifs comme partis apres
#  Y+4 (leurs donnees s'arretent a 348) -> c'est ca qui produit l'escalier a 100 %.
#
#  A coller dans UNE cellule. Prerequis dans le kernel : flux, stock, upstream,
#  HAS_UPSTREAM, cli (avec colonne "cohorte"), acq (Series periode d'acquisition
#  indexee par identifiant_tiers), cohort_of (Series annee de cohorte).
# ══════════════════════════════════════════════════════════════════════════
import numpy as np, pandas as pd

# Y+k  ->  tenure (en mois) marquant l'horizon. Y+5 = tenure 59 (max observable :
# 60 releves mensuels = tenures 0..59). Edite si besoin.
HORIZONS   = {1: 12, 2: 24, 3: 36, 4: 48, 5: 59}
CENSOR_TOL = 1     # tolerance latence (mois) avant de declarer un depart
MIN_N      = 30    # en dessous, l'horizon est note "/" (pas assez de recul)


def _churn_objects():
    """Reconstruit last_obs / obs_end / churned / churn_tenure / potential_window.
    obs_end = bord de donnees PAR COHORTE (extractions qui finissent a des mois
    differents : 2018->348, 2019->360, 2020->372, 2021+->384)."""
    lo_flux  = flux.groupby("identifiant_tiers")["periode"].max()
    lo_stock = stock.groupby("identifiant_tiers")["periode"].max()
    last_obs = pd.concat([lo_flux, lo_stock], axis=1).max(axis=1)

    coh     = cohort_of.reindex(last_obs.index)
    obs_end = last_obs.groupby(coh).transform("max")          # bord PAR COHORTE (pas global)

    if HAS_UPSTREAM:
        up_first = (upstream[upstream["scope"] == "BPL"]
                    .groupby("identifiant_tiers")["periode"].min())
    else:
        up_first = pd.Series(dtype="float64")
    upstreamed = pd.Series(cli.index.isin(up_first.index), index=cli.index)

    still_here = (last_obs >= (obs_end - CENSOR_TOL)).reindex(cli.index, fill_value=False)
    churned    = (~still_here) & ~upstreamed
    churn_tenure     = (last_obs.reindex(cli.index) + 1 - acq.reindex(cli.index)).where(churned)
    potential_window = (obs_end.reindex(cli.index) - acq.reindex(cli.index))   # tenure max observable
    return churned, churn_tenure, potential_window


def churn_table(horizons=HORIZONS, min_n=MIN_N):
    """% CUMULE de clients partis (churn) au bout de Y+k, une ligne par cohorte.
    Eligibilite : la cohorte doit etre observable jusqu'a la tenure T (potential_window >= T),
    sinon la cellule est "/". Numerateur = clients dont churn_tenure <= T."""
    churned, churn_tenure, pw = _churn_objects()
    rows = {}
    for c in sorted(cli["cohorte"].dropna().unique()):
        base = cli.index[cli["cohorte"] == c]
        r = {}
        for y, T in horizons.items():
            idx = base[pw.reindex(base) >= T]                 # observable a Y+y
            if len(idx) < min_n:
                r[f"Y+{y}"] = "/"
            else:
                r[f"Y+{y}"] = f"{(churn_tenure.reindex(idx) <= T).mean() * 100:.1f} %"
        rows[int(c)] = r
    tab = pd.DataFrame(rows).T
    tab.index.name = "Annee d'acquisition"
    return tab


# ── Table a remplir ─────────────────────────────────────────────────────────
tab_churn = churn_table()
print("CHURN CUMULE (% de la cohorte parti au bout de Y+k) :\n")
print(tab_churn.to_string(), "\n")

# ── Reconciliation avec le diagnostic (doit matcher : 2018 Y+4 ~24.6 %, 2022 ~28.6 %) ──
